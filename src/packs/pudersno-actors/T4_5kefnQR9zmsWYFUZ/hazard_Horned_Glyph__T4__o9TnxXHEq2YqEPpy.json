    "details": {
      "description": "<p>A large primal glyph stamped into solid stone and glowing with electric blue light.</p>",
      "disable": "<p>@Check[type:thievery|dc:28|basic:true] (expert) to erase the rune (requires thieves' tools and two successes)</p><p>@Check[type:nature|dc:28|basic:true] (master) to direct the goats to be summoned at the bottom of the mountain.</p><p><em>Dispel Magic</em> (6th level; counteract DC 28) to counteract the glyph.</p>",
      "isComplex": true,
      "level": {
        "value": 10
      },
      "publication": {
        "authors": "",
        "license": "OGL",
        "remaster": false,
        "title": ""
      },
      "reset": "",
      "routine": "<p>(1 action) If there are less than two Goat Guards on the board, the glyph summons enough Goat Guards that there are two Goat Guards. The new Goat Guards appear within 10 feet of the glyph and can act this turn.</p>\n<p>(1 action) Both Goat Guards can take their turns.&nbsp;&nbsp;</p>"
