      "img": "systems/pf2e/icons/actions/ThreeActions.webp",
      "name": "Clap [4 Actions]",
      "ownership": {
        "GlvvIehDY7BHTmwu": 3,
        "default": 0,
        "mqymE3yW5E90IiHw": 3
      },
      "sort": 0,
      "system": {
        "_migration": {
          "previous": {
            "foundry": "12.331",
            "schema": null,
            "system": "6.5.0"
