      "img": "systems/pf2e/icons/default-icons/action.svg",
      "name": "Modification: Curse of Greater Decay",
      "ownership": {
        "default": 0
      },
      "sort": 500000,
      "system": {
        "_migration": {
          "previous": {
            "foundry": "13.351",
            "schema": 0.954,
