      "img": "systems/pf2e/icons/actions/Passive.webp",
      "name": "Absolute Mind",
      "ownership": {
        "default": 0
      },
      "sort": 1000000,
      "system": {
        "_migration": {
          "previous": {
            "foundry": "13.351",
            "schema": 0.941,
